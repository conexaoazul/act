# BlueOps Odoo environment preset: PHD
BLUEOPS_ENV=phd
BLUEOPS_LABEL="PHD Transportes"
SERVICE=odoo-demo-phd-transporte
DB=phd_demo
URL=https://phd-demo.conexaoazul.com
IMAGE_PREFIX=ghcr.io/conexaoazul/odoo-demo-phd:
ADDONS_PATH=/usr/lib/python3/dist-packages/odoo/addons,/opt/odoo-enterprise,/opt/blue-addons
UPGRADE_MODULES=blue_custom_contracts,blue_custom_contracts_dynamic,blue_custom_hr_employee,blue_hr_employee_medical,blue_phd_documents
INSTALL_MODULES=blue_whatsapp_custom_contracts,blue_whatsapp_custom_contracts_dynamic
EXPECTED_MODULES=blue_custom_contracts,blue_custom_contracts_dynamic,blue_custom_hr_employee,blue_hr_employee_medical,blue_phd_documents,blue_whatsapp_custom_contracts,blue_whatsapp_custom_contracts_dynamic
BACKUP_ROOT=/var/lib/blueops/backups/phd
LOG_WINDOW=5m
UPDATE_MONITOR=20s
