# BlueOps Odoo environment template
BLUEOPS_ENV=cliente
BLUEOPS_LABEL="Cliente Odoo"
SERVICE=odoo-cliente
DEPLOY_ENABLED=0
RUNTIME_NODE=blueops-worker-1
DB=cliente_db
URL=https://cliente.exemplo.com
IMAGE_PREFIX=ghcr.io/conexaoazul/odoo-cliente:
ADDONS_PATH=/usr/lib/python3/dist-packages/odoo/addons,/opt/odoo-enterprise,/opt/blue-addons
UPGRADE_MODULES=
INSTALL_MODULES=
EXPECTED_MODULES=
BACKUP_ROOT=/var/lib/blueops/backups/cliente
LOG_WINDOW=5m
UPDATE_MONITOR=20s
