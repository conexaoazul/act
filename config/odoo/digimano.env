# BlueOps Odoo environment preset: Digimano
BLUEOPS_ENV=digimano
BLUEOPS_LABEL="Digimano Demo"
SERVICE=odoo-digimano-demo
DEPLOY_ENABLED=0
RUNTIME_NODE=blueops-oci-worker-2
RUNTIME_SSH=ociw2wg
DB=digimano-demo
URL=https://digimano-demo.conexaoazul.com
IMAGE_PREFIX=ghcr.io/conexaoazul/odoo-digimano-demo:
ADDONS_PATH=/mnt/extra-addons
UPGRADE_MODULES=
INSTALL_MODULES=
EXPECTED_MODULES=base
BACKUP_ROOT=/var/lib/blueops/backups/digimano
LOG_WINDOW=5m
UPDATE_MONITOR=20s
PRECREATE_EXTENSIONS=vector
DB_ADMIN_SERVICE=odin-standby-azul2
DB_ADMIN_USER=bluemaster
